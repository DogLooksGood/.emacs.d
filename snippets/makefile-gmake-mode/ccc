# -*- mode: snippet -*-
# name: ccc
# key: ccc
# expand-env: ((yas-indent-line 'fixed))
# --
.PHONY: build clean debug release check

debug:
	$(MAKE) $(MKFLAGS) build CONFIG=debug TARGET=$(BIN)
release:
	$(MAKE) $(MKFLAGS) build CONFIG=release TARGET=$(BIN)
check:
	$(MAKE) $(MKFLAGS) build CONFIG=test TARGET=$(TEST)$(TESTSUFX)
	./$(BUILD)/test/$(TEST)$(TESTSUFX)
clean:
	$(RM) -rf $(BUILD)

BUILD    = build
SRCDIR   = src
TESTDIR  = test
TESTSUFX = _test
BIN      = $(notdir $(CURDIR))
OUTDIR   = $(BUILD)/$(CONFIG)
SRCS     = $(wildcard $(SRCDIR)/*.c)
OBJS     = $(SRCS:$(SRCDIR)/%.c=$(OUTDIR)/%.o)
DEPS     = $(SRCS:$(SRCDIR)/%.c=$(OUTDIR)/%.d)
CFLAGS   = -Wall -Wextra -Wshadow -std=gnu17
CPPFLAGS = -MMD -MP
LDFLAGS  = -fuse-ld=mold
LIBS     =
SANFLAGS = -fsanitize=address -fno-omit-frame-pointer
MKFLAGS  = -k -j 4 --no-print-directory

ifeq ($(CONFIG), debug)
	CFLAGS  += $(SANFLAGS) -g3 -O0
	LDFLAGS += $(SANFLAGS)
else ifeq ($(CONFIG), release)
	CFLAGS  += -O3
else ifeq ($(CONFIG), test)
	OBJS    += $(OUTDIR)/$(TARGET).o
	CFLAGS  += $(SANFLAGS) -g3 -O0 -DTEST
	LDFLAGS += $(SANFLAGS)
endif

build: $(OUTDIR)/$(TARGET)

vpath %c $(SRCDIR) $(TESTDIR)

$(OUTDIR):
	@mkdir -p $(OUTDIR)

$(OUTDIR)/%.o: %.c | $(OUTDIR)
	$(CC) -c $< -o $@ $(CFLAGS) $(CPPFLAGS)

$(OUTDIR)/$(TARGET): $(OBJS) | $(OUTDIR)
	$(CC) $^ -o $@ $(LDFLAGS) $(LIBS)

-include $(DEPS)
