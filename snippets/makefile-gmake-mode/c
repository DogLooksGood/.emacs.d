# -*- mode: snippet -*-
# name: c
# key: ccc
# expand-env: ((yas-indent-line 'fixed))
# --
OUTDIR    = build
TESTDIR   = build/test
SRCS      = $(wildcard src/*.c)
OBJS      = $(SRCS:src/%.c=$(OUTDIR)/%.o)
TESTOBJS  = $(SRCS:src/%.c=$(TESTDIR)/%.o)
DEPS      = $(SRCS:src/%.c=$(OUTDIR)/%.d)
TESTDEPS  = $(SRCS:src/%.c=$(TESTDIR)/%.d)
TARGET    = $(OUTDIR)/$(notdir $(CURDIR))
SANFLAGS  = -fsanitize=address
CFLAGS    = -std=gnu17 -Wall -Wextra -Wshadow -ggdb -Wno-unused-parameter
CPPFLAGS  = -MMD -MP
LDFLAGS   =
LDLIBS    =
TESTS     =

.SECONDEXPANSION:

$(TARGET): $(OBJS)
	$(CC) $^ -o $@ $(LDFLAGS) $(LDLIBS)

$(TESTDIR)/%: src/%.c $(TESTOBJS)
	$(CC) $(filter-out $(TESTDIR)/$*.o,$^) -o $@ \
	$(LDFLAGS) $(LDLIBS) $(SANFLAGS) -DTEST_$*

$(OUTDIR)/%.o: src/%.c
	@mkdir -p $(@D)
	$(CC) $< -o $@ -c $(CFLAGS) $(CPPFLAGS)

$(TESTDIR)/%.o: src/%.c
	@mkdir -p $(@D)
	$(CC) $< -o $@ -c $(CFLAGS) $(CPPFLAGS) $(SANFLAGS)

test-%: $(TESTDIR)/%
	./$<

check: $(addprefix test-,$(TESTS))

clean:
	rm -rf $(OUTDIR)

-include $(DEPS)
-include $(TESTDEPS)

.PHONY: clean check
